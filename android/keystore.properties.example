# Copy this file to keystore.properties in this folder (android/) and fill in your values.
# Never commit keystore.properties or your .jks file.
#
# Create an upload keystore (one-time):
#   keytool -genkeypair -v -storetype PKCS12 -keystore app/upload-keystore.jks -alias YOUR_ALIAS -keyalg RSA -keysize 2048 -validity 10000
#
storePassword=your-store-password
keyPassword=your-key-password
keyAlias=your-key-alias
# Path relative to the android/ directory:
storeFile=app/upload-keystore.jks
